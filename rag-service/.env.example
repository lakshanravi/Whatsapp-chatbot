OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
CHROMA_PERSIST_DIR=./chroma_data
# Optional. Defaults to <CHROMA_PERSIST_DIR>/lexical_index.sqlite3.
FTS_PERSIST_PATH=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=128
VECTOR_STORE_BATCH_SIZE=500
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=5
TOP_K=5
RETRIEVAL_CANDIDATES=40
MINIMUM_RELEVANCE_SCORE=0.25
ENABLE_RERANKING=true
ENABLE_ANSWER_VERIFICATION=true
ENABLE_NUMERIC_VERIFICATION=true
CONVERSATION_HISTORY_MESSAGES=16
MAX_CLARIFICATION_ROUNDS=2
ENABLE_LOCAL_OCR=true
OCR_MIN_PAGE_CHARACTERS=80
OCR_IMAGE_RICH_PAGES=true
OCR_IMAGE_PAGE_CHARACTER_LIMIT=1200
OCR_DPI=300
OCR_LANGUAGE=eng
TESSERACT_CMD=
DESCRIBE_PDF_IMAGES=true
DESCRIBE_FULL_VISUAL_PAGES=true
VISION_PAGE_DPI=300
VISION_MAX_TOKENS=1400
VISION_PAGE_CHARACTER_LIMIT=1600
MIN_VECTOR_DRAWINGS_FOR_VISUAL_PAGE=8
MAX_DESCRIBED_IMAGES_PER_PAGE=3
RAG_SERVICE_PORT=8000
